<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="app.aaps.pump.ypso.ui.YpsoOverviewFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/ypso_read_only_banner"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1">

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_connection_label" />

                <TextView
                    android:id="@+id/connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Disconnected" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_last_connection_label" />

                <TextView
                    android:id="@+id/last_connection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2 min ago" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_serial_label" />

                <TextView
                    android:id="@+id/serial_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="10178681" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_mac_label" />

                <TextView
                    android:id="@+id/mac_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="EC:2A:F0:01:22:34" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_firmware_label" />

                <TextView
                    android:id="@+id/firmware"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="5.2.3" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_reservoir_label" />

                <TextView
                    android:id="@+id/reservoir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="123.4 U" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_battery_label" />

                <TextView
                    android:id="@+id/battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="80%" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_delivery_mode_label" />

                <TextView
                    android:id="@+id/delivery_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Basal" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_active_profile_label" />

                <TextView
                    android:id="@+id/active_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="A" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_basal_rate_label" />

                <TextView
                    android:id="@+id/basal_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0.85 U/h" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_temp_basal_label" />

                <TextView
                    android:id="@+id/temp_basal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="---" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/ypso_clock_label" />

                <TextView
                    android:id="@+id/pump_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="In sync with phone (2 s)" />
            </TableRow>
        </TableLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/refresh"
                style="@style/GrayButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ypso_refresh" />

            <Button
                android:id="@+id/read_history"
                style="@style/GrayButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ypso_read_history" />

            <Button
                android:id="@+id/set_clock"
                style="@style/GrayButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ypso_set_clock" />
        </LinearLayout>

        <!--
            Phase 8a bench instrument. On its own row and away from the others because it MOVES
            FLUID, and because it should be obvious that it is not one of the read buttons.
        -->
        <Button
            android:id="@+id/extended_bolus_probe"
            style="@style/GrayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ypso_ext_probe" />
    </LinearLayout>
</ScrollView>
